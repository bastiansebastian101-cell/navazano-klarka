generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String   @id @default(cuid())
  nameCs        String
  nameEn        String
  descriptionCs String
  descriptionEn String
  priceCzk      Int // haléře, e.g. 89900 = 899 Kč
  category      String // "bouquet" | "plant" | "gift"
  imageUrls     String[] @default([]) // up to 3 photos
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())

  orderItems OrderItem[]
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     Int       @unique @default(autoincrement()) // numeric, used as the bank payment Variable Symbol
  customerName    String
  phone           String
  email           String
  deliveryAddress String
  deliveryDate    DateTime
  deliveryWindow  String // "9-12" | "12-15" | "15-18"
  paymentMethod   String // "bank_transfer" | "cash_on_delivery"
  status          String    @default("new") // new | confirmed | out_for_delivery | delivered | cancelled
  notes           String?
  totalCzk        Int
  discountCzk     Int       @default(0)
  createdAt       DateTime  @default(now())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  couponId        String?
  coupon          Coupon?   @relation(fields: [couponId], references: [id])

  items OrderItem[]
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountType    String // "percentage" | "fixed"
  discountValue   Int // percentage: 1-100; fixed: haléře
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  orders Order[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String
  createdAt DateTime @default(now())

  orders Order[]
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceCzk  Int // price at time of order
}
