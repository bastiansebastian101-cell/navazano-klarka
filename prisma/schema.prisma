generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Product {
  id            String   @id @default(cuid())
  nameCs        String
  nameEn        String
  descriptionCs String
  descriptionEn String
  priceCzk      Int // haléře, e.g. 89900 = 899 Kč
  category      String // "bouquet" | "plant" | "gift"
  imageUrls     String[] @default([]) // up to 3 photos
  active        Boolean  @default(true)
  featuredOnHome Boolean @default(false) // admin-controlled: shown on homepage featured section instead of only the 3 newest
  createdAt     DateTime @default(now())

  orderItems OrderItem[]
}

model Order {
  id              String    @id @default(cuid())
  orderNumber     Int       @unique @default(autoincrement()) // numeric, used as the bank payment Variable Symbol
  customerName    String
  phone           String
  email           String
  deliveryAddress String
  deliveryDate    DateTime
  deliveryWindow  String // "9-12" | "12-15" | "15-18"
  paymentMethod   String // "bank_transfer" | "cash_on_delivery"
  status          String    @default("new") // new | confirmed | out_for_delivery | delivered | cancelled
  notes           String?
  totalCzk        Int
  discountCzk     Int       @default(0)
  createdAt       DateTime  @default(now())
  customerId      String?
  customer        Customer? @relation(fields: [customerId], references: [id])
  couponId        String?
  coupon          Coupon?   @relation(fields: [couponId], references: [id])
  reviewInviteSentAt DateTime?
  occasionReason           String? // e.g. "manželčiny narozeniny" — free text, used for the yearly reminder email
  occasionReminderSentYear Int? // calendar year the occasion reminder was last sent, so it fires at most once per year

  items  OrderItem[]
  review Review?
}

model Coupon {
  id              String    @id @default(cuid())
  code            String    @unique
  discountType    String // "percentage" | "fixed"
  discountValue   Int // percentage: 1-100; fixed: haléře
  maxRedemptions  Int?
  redemptionCount Int       @default(0)
  active          Boolean   @default(true)
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())

  orders Order[]
}

model Customer {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String
  createdAt DateTime @default(now())

  orders Order[]
}

model LoginToken {
  id        String    @id @default(cuid())
  token     String    @unique
  email     String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model CustomRequest {
  id                 String    @id @default(cuid())
  name               String
  email              String
  phone              String?
  deliveryDate       DateTime?
  deliveryAddress    String? // nullable for backward-compat with pre-existing rows; required client+server-side for new submissions
  message            String
  imageUrl           String?
  bouquetName        String?
  priceCzk           Int? // haléře, set by admin when creating the invoice
  invoiceNumber      Int       @unique @default(autoincrement()) // used as the QR payment variable symbol (with an offset, see src/lib/payment.ts usage)
  invoiceSentAt      DateTime?
  deliveredAt        DateTime?
  reviewInviteSentAt DateTime?
  occasionReason           String?
  occasionReminderSentYear Int?
  createdAt          DateTime  @default(now())

  review Review?
}

model Review {
  id              String         @id @default(cuid())
  customerName    String
  rating          Int // 1-5
  comment         String
  orderId         String?        @unique
  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  customRequestId String?        @unique
  customRequest   CustomRequest? @relation(fields: [customRequestId], references: [id], onDelete: SetNull)
  editedAt        DateTime? // set when admin edits an existing review — internal audit marker, never shown publicly
  createdAt       DateTime       @default(now())
}

model ReviewInvite {
  id              String    @id @default(cuid())
  token           String    @unique
  orderId         String?
  customRequestId String?
  email           String
  expiresAt       DateTime
  usedAt          DateTime?
  createdAt       DateTime  @default(now())
}

model OrderItem {
  id        String @id @default(cuid())
  orderId   String
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int
  priceCzk  Int // price at time of order
}
